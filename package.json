{
  "name": "norges-apotek-sokndal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:utkast": "tsc -b && vite build --mode singlefile && node -e \"require('fs').mkdirSync('utkast',{recursive:true});require('fs').copyFileSync('dist-utkast/index.html','utkast/norges-apotek-sokndal-utkast.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "generer:topo": "node scripts/generate-topo.mjs",
    "generer:logo": "python scripts/generate-logo.py",
    "generer:profil": "node scripts/render-profil.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "d3-contour": "^4.0.3",
    "d3-geo": "^3.1.2",
    "simplex-noise": "^4.0.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
